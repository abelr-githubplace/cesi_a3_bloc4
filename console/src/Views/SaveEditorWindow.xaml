<Window x:Class="EasySave.Console.Views.SaveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Éditeur de sauvegarde"
        Height="310" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Nom -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- Source -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- Destination -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- Type -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- Boutons OK/Annuler -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nom du job" Margin="0,0,0,4"/>
        <TextBox   Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                   Padding="5,4" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="Dossier source" Margin="0,0,0,4"/>
        <DockPanel Grid.Row="3" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="…"
                    Command="{Binding BrowseSourceCommand}"
                    Padding="8,4" Margin="6,0,0,0" Width="32"/>
            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"/>
        </DockPanel>

        <TextBlock Grid.Row="4" Text="Dossier de destination" Margin="0,0,0,4"/>
        <DockPanel Grid.Row="5" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="…"
                    Command="{Binding BrowseDestCommand}"
                    Padding="8,4" Margin="6,0,0,0" Width="32"/>
            <TextBox Text="{Binding DestPath, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"/>
        </DockPanel>

        <TextBlock Grid.Row="6" Text="Type de sauvegarde" Margin="0,0,0,4"/>
        <ComboBox  Grid.Row="7" ItemsSource="{Binding SaveTypes}"
                   SelectedItem="{Binding SaveType}"
                   Padding="5,4" Margin="0,0,0,0"/>

        <!-- Boutons de validation -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" IsCancel="True"  Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="OK"      Click="OK_Click" Padding="16,6" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
