<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
<PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\PrimeService\**" />
    <EmbeddedResource Remove="tests\PrimeService\**" />
    <None Remove="tests\PrimeService\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\lang\Messages.Designer.cs" Link="Ressources\Messages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Messages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Messages.Designer.cs (shared with the GUI) hardcodes the resource name
         to "EasySave.GUI.Ressources.Messages.resources". LogicalName forces the
         CLI assembly to embed the resource under the same name so the lookup
         succeeds in both projects. -->
    <EmbeddedResource Include="..\lang\Messages.fr.resx" Link="Ressources\Messages.fr.resx">
      <LogicalName>EasySave.GUI.Ressources.Messages.fr.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\lang\Messages.resx" Link="Ressources\Messages.resx">
      <LogicalName>EasySave.GUI.Ressources.Messages.resources</LogicalName>
      <CustomToolNamespace>EasySave.lang</CustomToolNamespace>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Messages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lib\EasySaveLibrary.csproj" />
    <ProjectReference Include="..\logger\EasyLog.csproj" />
  </ItemGroup>

</Project>
