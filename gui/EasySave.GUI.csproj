<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\lib\EasySaveLibrary.csproj" />
    <ProjectReference Include="..\logger\EasyLog.csproj" />
    <!-- Build CryptoSoft before the GUI but don't link against it: it's an
         external executable launched out-of-process by CryptoSoftRunner. The
         post-build target below copies the produced .exe next to the GUI so
         AppContext.BaseDirectory + "CryptoSoft.exe" resolves at runtime. -->
    <ProjectReference Include="..\CryptoSoft\CryptoSoft.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Publish CryptoSoft as a single-file self-contained exe, then copy it
       next to the GUI so AppContext.BaseDirectory + "CryptoSoft.exe" resolves.
       The publish step bundles the runtime into one file with no extra DLLs. -->
  <Target Name="CopyCryptoSoft" AfterTargets="Build">
    <MSBuild Projects="..\CryptoSoft\CryptoSoft.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishTrimmed=true" />
    <ItemGroup>
      <_CryptoSoftPublished Include="..\CryptoSoft\bin\$(Configuration)\net8.0\win-x64\publish\CryptoSoft.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_CryptoSoftPublished)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('@(_CryptoSoftPublished)')" />
  </Target>

  <ItemGroup>
    <Compile Include="..\lang\Messages.Designer.cs" Link="Ressources\Messages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Messages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\lang\Messages.fr.resx" Link="Ressources\Messages.fr.resx">
      <LogicalName>EasySave.GUI.Ressources.Messages.fr.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\lang\Messages.resx" Link="Ressources\Messages.resx">
      <CustomToolNamespace>EasySave.lang</CustomToolNamespace>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Messages.Designer.cs</LastGenOutput>
      <LogicalName>EasySave.GUI.Ressources.Messages.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
