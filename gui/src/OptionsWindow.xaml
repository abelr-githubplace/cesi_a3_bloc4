<Window x:Class="EasySave.GUI.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:EasySave.lang"
        xmlns:helpers="clr-namespace:EasySave.GUI.Helpers"
        Title="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[OptionMenuTitle]}" 
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f2fcff" Foreground="Black">

    <Window.Resources>
        <SolidColorBrush x:Key="MainBlue" Color="#aadff0"/>
        <SolidColorBrush x:Key="Background" Color="#f2fcff"/>
        <SolidColorBrush x:Key="DarkerBlue" Color="#6e909b"/>
        <SolidColorBrush x:Key="DarkestBlue" Color="#324146"/>
        <SolidColorBrush x:Key="Black" Color="Black"/>
        <SolidColorBrush x:Key="White" Color="White"/>
        <SolidColorBrush x:Key="CTA" Color="#f0bbaa"/>
        <SolidColorBrush x:Key="Red" Color="#ffbdbd"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkerBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="3"/>
                </Style>
            </Style.Resources>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" Background="{StaticResource White}" BorderBrush="{StaticResource DarkerBlue}" BorderThickness="1" CornerRadius="3">
                <Path x:Name="Arrow" Fill="{StaticResource Black}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L8,0 L4,5 Z"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{StaticResource MainBlue}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,5,30,5" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="{StaticResource White}" BorderThickness="1" BorderBrush="{StaticResource DarkerBlue}" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MainBlue}"/>
                    <Setter Property="Foreground" Value="{StaticResource Black}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource MainBlue}"/>
                    <Setter Property="Foreground" Value="{StaticResource Black}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DarkerBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Black}"/>
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource MainBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Choix de la langue -->
        <Label Grid.Row="0" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[ChooseLanguage]}"/>
        <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding language}" SelectedValuePath="Content" Margin="0,0,0,15">
            <ComboBoxItem Content="FR"/>
            <ComboBoxItem Content="EN"/>
        </ComboBox>

        <!-- Format des logs -->
        <Label Grid.Row="1" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[LogFormat]}"/>
        <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding LogFormat}" SelectedValuePath="Content" Margin="0,0,0,15">
            <ComboBoxItem Content="JSON"/>
            <ComboBoxItem Content="XML"/>
            <ComboBoxItem Content="TXT"/>
        </ComboBox>

        <!-- Chemin du log local -->
        <Label Grid.Row="2" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[OptionMenuLogOutput]}"/>
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding LogOutput}" ToolTip="Ex: .\\save.log" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Content="..." Command="{Binding BrowseLogOutputCommand}" MinWidth="35" Padding="10,5"/>
        </Grid>

        <!-- Chemin du state.json -->
        <Label Grid.Row="3" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[OptionMenuStateOutput]}"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding StateOutput}" ToolTip="Ex: .\\state.json" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Content="..." Command="{Binding BrowseStateOutputCommand}" MinWidth="35" Padding="10,5"/>
        </Grid>

        <!-- Logiciels Métiers (Multiple) -->
        <Label Grid.Row="4" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[BuisinessSoftware]}" VerticalAlignment="Top" Margin="0,10,10,0"/>
        <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding BusinessSoftwares}" 
                     SelectedItem="{Binding SelectedBusinessSoftware}"
                     BorderBrush="{StaticResource DarkerBlue}" BorderThickness="1" Background="{StaticResource White}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                            <Button Grid.Column="1" 
                                    Command="{Binding DataContext.RemoveSoftwareCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Background="{StaticResource Red}" Width="25" Height="25" Padding="5" Margin="5,0,0,0"
                                    ToolTip="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Delete]}">
                                <Path Data="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z"
                                      Fill="{StaticResource Black}" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="1" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[AddSave]}"
                    Command="{Binding BrowseSoftwareCommand}" 
                    HorizontalAlignment="Right" Margin="0,5,0,0" Padding="15,5"/>
        </Grid>

        <!-- Extensions à chiffrer -->
        <Label Grid.Row="5" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[ExtensionsToEncrypt]}" VerticalAlignment="Top" Margin="0,10,10,0"/>
        <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding EncryptionExtensions}"
                     BorderBrush="{StaticResource DarkerBlue}" BorderThickness="1" Background="{StaticResource White}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.RemoveEncryptionExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Background="{StaticResource Red}" Width="25" Height="25" Padding="5" Margin="5,0,0,0"
                                    ToolTip="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Delete]}">
                                <Path Data="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z"
                                      Fill="{StaticResource Black}" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <TextBox Width="180" Text="{Binding NewEncryptionExtension}" ToolTip="Ex: .txt" Margin="0,0,10,0"/>
                <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[AddSave]}"
                        Command="{Binding AddEncryptionExtensionCommand}" Padding="15,5"/>
            </StackPanel>
        </Grid>

        <!-- Extensions prioritaires -->
        <Label Grid.Row="6" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[PriorityExtensions]}" VerticalAlignment="Top" Margin="0,10,10,0"/>
        <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding PriorityExtensions}"
                     BorderBrush="{StaticResource DarkerBlue}" BorderThickness="1" Background="{StaticResource White}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.RemovePriorityExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Background="{StaticResource Red}" Width="25" Height="25" Padding="5" Margin="5,0,0,0"
                                    ToolTip="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Delete]}">
                                <Path Data="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z"
                                      Fill="{StaticResource Black}" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <TextBox Width="180" Text="{Binding NewPriorityExtension}" ToolTip="Ex: .iso" Margin="0,0,10,0"/>
                <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[AddSave]}"
                        Command="{Binding AddPriorityExtensionCommand}" Padding="15,5"/>
            </StackPanel>
        </Grid>

        <!-- Limite de fichier volumineux -->
        <Label Grid.Row="7" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[LargeFileThreshold]}"/>
        <Grid Grid.Row="7" Grid.Column="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding LargeFileLimit}" ToolTip="Ex: 10240 (10 Mo)" Margin="0,0,10,0"
                     PreviewTextInput="NumberValidationTextBox" InputScope="Number"/>
            <Label Grid.Column="1" Content="Ko" Margin="0" VerticalAlignment="Center"/>
        </Grid>

        <!-- Mode de log (Local / Remote / Both) -->
        <Label Grid.Row="8" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[LogMode]}"/>
        <ComboBox Grid.Row="8" Grid.Column="1" SelectedValue="{Binding LogMode}" SelectedValuePath="Content" Margin="0,0,0,15">
            <ComboBoxItem Content="Local"/>
            <ComboBoxItem Content="Remote"/>
            <ComboBoxItem Content="Both"/>
        </ComboBox>

        <!-- Adresse du serveur de logs -->
        <Label Grid.Row="9" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[RemoteLogHost]}"/>
        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding RemoteLogHost}"
                 ToolTip="Ex: 192.168.1.10" Margin="0,0,0,15"/>

        <!-- Port du serveur de logs -->
        <Label Grid.Row="10" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[RemoteLogPort]}"/>
        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding RemoteLogPort}"
                 ToolTip="Ex: 9000" Margin="0,0,0,15"
                 PreviewTextInput="NumberValidationTextBox" InputScope="Number"/>

        <!-- Actions + toast -->
        <Grid Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource MainBlue}" CornerRadius="4" Padding="10,6"
                    VerticalAlignment="Center" Visibility="{Binding ApplyToastVisibility}">
                <TextBlock Text="{Binding ApplyToastText}" Foreground="{StaticResource Black}" />
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[ApplyChanges]}"
                        Command="{Binding ApplyCommand}" IsEnabled="{Binding IsDirty}" Margin="0,0,10,0" MinWidth="130" Background="{StaticResource CTA}"/>
                <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Close]}" Click="Close_Click" MinWidth="100"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>