<Window x:Class="EasySave.GUI.Views.SaveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Éditeur de Sauvegarde" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="35"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Nom :"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" VerticalAlignment="Center"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Source :"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,10" VerticalAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="2" Content="..." Command="{Binding BrowseSourceCommand}" Margin="0,0,0,10"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Cible :"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,10" VerticalAlignment="Center"/>
        <Button Grid.Row="2" Grid.Column="2" Content="..." Command="{Binding BrowseTargetCommand}" Margin="0,0,0,10"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Type :"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedValue="{Binding Type}" SelectedValuePath="Content" Margin="0,0,0,10">
            <ComboBoxItem Content="Complète"/>
            <ComboBoxItem Content="Différentielle"/>
        </ComboBox>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Click="Cancel_Click" Width="75" Margin="0,0,10,0"/>
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" Click="Save_Click" Width="75"/>
        </StackPanel>
    </Grid>
</Window>