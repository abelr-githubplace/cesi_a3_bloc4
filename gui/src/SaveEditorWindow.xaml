<Window x:Class="EasySave.GUI.Views.SaveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:EasySave.lang"
        Title="{x:Static lang:Messages.SaveEditor}" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="35"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="{x:Static lang:Messages.Name}"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" VerticalAlignment="Center"/>

        <Label Grid.Row="1" Grid.Column="0" Content="{x:Static lang:Messages.Source}"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,10" VerticalAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="2" Content="..." Command="{Binding BrowseSourceCommand}" Margin="0,0,0,10"/>

        <Label Grid.Row="2" Grid.Column="0" Content="{x:Static lang:Messages.Target}"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,10" VerticalAlignment="Center"/>
        <Button Grid.Row="2" Grid.Column="2" Content="..." Command="{Binding BrowseTargetCommand}" Margin="0,0,0,10"/>

        <Label Grid.Row="3" Grid.Column="0" Content="{x:Static lang:Messages.Type}"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedValue="{Binding Type}" SelectedValuePath="Content" Margin="0,0,0,10">
            <ComboBoxItem Content="{x:Static lang:Messages.Complete}"/>
            <ComboBoxItem Content="{x:Static lang:Messages.Differential}"/>
        </ComboBox>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static lang:Messages.MainMenuExit}" Click="Cancel_Click" Width="75" Margin="0,0,10,0"/>
            <Button Content="{x:Static lang:Messages.MainMenuSave}" Command="{Binding SaveCommand}" Click="Save_Click" Width="Auto"/>
        </StackPanel>
    </Grid>
</Window>