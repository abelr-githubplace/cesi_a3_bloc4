<Window x:Class="EasySave.GUI.Views.SaveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="clr-namespace:EasySave.lang"
        xmlns:helpers="clr-namespace:EasySave.GUI.Helpers"
        Title="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[SaveEditor]}" 
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f2fcff" Foreground="Black">

    <Window.Resources>
        <SolidColorBrush x:Key="MainBlue" Color="#aadff0"/>
        <SolidColorBrush x:Key="Background" Color="#f2fcff"/>
        <SolidColorBrush x:Key="DarkerBlue" Color="#6e909b"/>
        <SolidColorBrush x:Key="DarkestBlue" Color="#324146"/>
        <SolidColorBrush x:Key="Black" Color="Black"/>
        <SolidColorBrush x:Key="White" Color="White"/>
        <SolidColorBrush x:Key="CTA" Color="#f0bbaa"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkerBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="3"/>
                </Style>
            </Style.Resources>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" Background="{StaticResource White}" BorderBrush="{StaticResource DarkerBlue}" BorderThickness="1" CornerRadius="3">
                <Path x:Name="Arrow" Fill="{StaticResource Black}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L8,0 L4,5 Z"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{StaticResource MainBlue}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,5,30,5" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="{StaticResource White}" BorderThickness="1" BorderBrush="{StaticResource DarkerBlue}" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MainBlue}"/>
                    <Setter Property="Foreground" Value="{StaticResource Black}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource MainBlue}"/>
                    <Setter Property="Foreground" Value="{StaticResource Black}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DarkerBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Black}"/>
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource MainBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CTAButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource CTA}"/>
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <!-- Désactiver si le champ Nom est vide -->
                <DataTrigger Binding="{Binding Text, ElementName=NameTextBox}" Value="">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <!-- Désactiver si le champ Source est vide -->
                <DataTrigger Binding="{Binding Text, ElementName=SourceTextBox}" Value="">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <!-- Désactiver si le champ Cible est vide -->
                <DataTrigger Binding="{Binding Text, ElementName=TargetTextBox}" Value="">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <!-- Désactiver si aucun type n'est sélectionné -->
                <DataTrigger Binding="{Binding SelectedItem, ElementName=TypeComboBox}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>

        <!-- Champ : Nom -->
        <Label Grid.Row="0" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Name]}" ContentStringFormat="{}{0}"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" VerticalAlignment="Center"/>

        <!-- Champ : Source -->
        <Label Grid.Row="1" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Source]}" ContentStringFormat="{}{0}"/>
        <TextBox x:Name="SourceTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,15" VerticalAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="2" Content="..." Command="{Binding BrowseSourceCommand}" Margin="0,0,0,15" Padding="5"/>

        <!-- Champ : Cible -->
        <Label Grid.Row="2" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Target]}" ContentStringFormat="{}{0}"/>
        <TextBox x:Name="TargetTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,15" VerticalAlignment="Center"/>
        <Button Grid.Row="2" Grid.Column="2" Content="..." Command="{Binding BrowseTargetCommand}" Margin="0,0,0,15" Padding="5"/>

        <!-- Champ : Type -->
        <Label Grid.Row="3" Grid.Column="0" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Type]}" ContentStringFormat="{}{0}"/>
        <ComboBox x:Name="TypeComboBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedValue="{Binding Type}" SelectedValuePath="Tag" Margin="0,0,0,15">
            <ComboBoxItem Tag="Complete"     Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Complete]}"/>
            <ComboBoxItem Tag="Differential" Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Differential]}"/>
            <ComboBoxItem Tag="Delta"        Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Delta]}"/>
        </ComboBox>

        <!-- Boutons d'action -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[MainMenuExit]}" Click="Cancel_Click" MinWidth="100" Margin="0,0,10,0"/>
            <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[AddSave]}" Command="{Binding SaveCommand}" Click="Save_Click" Style="{StaticResource CTAButtonStyle}" MinWidth="120"/>
        </StackPanel>
    </Grid>
</Window>