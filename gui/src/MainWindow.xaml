<Window x:Class="EasySave.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:EasySave.lang"
        mc:Ignorable="d"
        Title="EasySave 2.0" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{x:Static lang:Messages.NewJob}" Command="{Binding AddJobCommand}" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="{x:Static lang:Messages.Options}" Command="{Binding OpenOptionsCommand}" Margin="0,0,10,0" Padding="10,5"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding SaveJobs}" SelectedItem="{Binding SelectedJob}" 
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static lang:Messages.Name}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{x:Static lang:Messages.Source}" Binding="{Binding SourcePath}" Width="2*"/>
                <DataGridTextColumn Header="{x:Static lang:Messages.Target}" Binding="{Binding TargetPath}" Width="2*"/>
                <DataGridTextColumn Header="{x:Static lang:Messages.Type}" Binding="{Binding Type}" Width="*"/>
                <DataGridTextColumn Header="{x:Static lang:Messages.State}" Binding="{Binding State}" Width="*"/>
                <DataGridTextColumn Header="{x:Static lang:Messages.Progress}" Binding="{Binding Progress, StringFormat={}{0}%}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static lang:Messages.Edit}" Command="{Binding EditJobCommand}" CommandParameter="{Binding SelectedJob}"/>
                    <MenuItem Header="{x:Static lang:Messages.Delete}" Command="{Binding DeleteJobCommand}" CommandParameter="{Binding SelectedJob}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{x:Static lang:Messages.RunSelected}" Command="{Binding RunSelectedJobCommand}" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="{x:Static lang:Messages.RunAll}" Command="{Binding RunAllJobsCommand}" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>