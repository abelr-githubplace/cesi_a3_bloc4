<Window x:Class="EasySave.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:EasySave.lang"
        xmlns:helpers="clr-namespace:EasySave.GUI.Helpers"
        mc:Ignorable="d"
        Title="EasySave 2.0" Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#f2fcff" Foreground="Black">

    <Window.Resources>
        <SolidColorBrush x:Key="MainBlue" Color="#aadff0"/>
        <SolidColorBrush x:Key="Background" Color="#f2fcff"/>
        <SolidColorBrush x:Key="DarkerBlue" Color="#6e909b"/>
        <SolidColorBrush x:Key="DarkestBlue" Color="#324146"/>
        <SolidColorBrush x:Key="Black" Color="Black"/>
        <SolidColorBrush x:Key="White" Color="White"/>
        <SolidColorBrush x:Key="CTA" Color="#f0bbaa"/>
        <SolidColorBrush x:Key="Orange" Color="#d99561"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#ffbdbd"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#bdffbd"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DarkerBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="CTAButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource CTA}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
        </Style>

        <Style x:Key="LeftCenterTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="{StaticResource MainBlue}"/>
            <Setter Property="AlternatingRowBackground" Value="#e0f4fa"/>
            <Setter Property="Foreground" Value="{StaticResource Black}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="40"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource DarkerBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkestBlue}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[NewJob]}" Command="{Binding AddJobCommand}" Margin="0,0,10,0" Style="{StaticResource CTAButtonStyle}"/>
            <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Options]}" Command="{Binding OpenOptionsCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding SaveJobs}" SelectedItem="{Binding SelectedJob}" 
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">

            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
            </DataGrid.Resources>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="50">
                    <!-- Ajout du HeaderTemplate pour le "Select All" -->
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Name]}" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource LeftCenterTextStyle}"/>
                <DataGridTextColumn Header="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Type]}" Binding="{Binding Type}" Width="*" ElementStyle="{StaticResource LeftCenterTextStyle}"/>
                <DataGridTextColumn Header="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[State]}" Binding="{Binding State}" Width="1.5*" ElementStyle="{StaticResource LeftCenterTextStyle}"/>

                <DataGridTemplateColumn Header="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[Progress]}" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="10,0">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" 
                                             Height="18" Background="{StaticResource White}" Foreground="{StaticResource SuccessGreen}" BorderBrush="{StaticResource DarkerBlue}" BorderThickness="1"/>
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:0.00}%}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           Foreground="{StaticResource Black}" FontWeight="SemiBold" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Actions" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!-- Play -->
                                <Button Background="Transparent" Padding="5"
                                        Command="{Binding DataContext.PlayJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" Margin="2">
                                    <Path Data="M 0,0 L 12,7 L 0,14 Z" Fill="{StaticResource Black}" Width="12" Height="14" Stretch="Uniform"/>
                                </Button>

                                <!-- Pause -->
                                <Button Background="Transparent" Padding="5"
                                        Command="{Binding DataContext.PauseJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" Margin="2">
                                    <Path Data="M 0,0 H 4 V 14 H 0 Z M 8,0 H 12 V 14 H 8 Z" Fill="{StaticResource Black}" Width="12" Height="14" Stretch="Uniform"/>
                                </Button>

                                <!-- Stop -->
                                <Button Background="Transparent" Padding="5"
                                        Command="{Binding DataContext.StopJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" Margin="2">
                                    <Path Data="M 0,0 H 14 V 14 H 0 Z" Fill="{StaticResource Black}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>

                                <!-- Restore / Rotate-Left -->
                                <Button Background="Transparent" Padding="5"
                                        Command="{Binding DataContext.RestoreJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" Margin="2">
                                    <Path Data="M 3,7 L 7,3 L 7,6 C 10.5,6 13.5,8.5 13.5,12 C 13.5,13.5 12.8,14.8 11.7,15.6 L 10.3,14 C 11,13.5 11.5,12.8 11.5,12 C 11.5,9.8 9.7,8 7.5,8 L 7,8 L 7,11 L 3,7 Z" 
                                          Fill="{StaticResource Black}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>

                                <!-- Edit / Pen-to-Square -->
                                <Button Background="Transparent" Padding="5"
                                        Command="{Binding DataContext.EditJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" Margin="2">
                                    <Path Data="M 11,2 L 13,4 L 5,12 L 3,12 L 3,10 L 11,2 Z M 11.5,0.5 L 14.5,3.5 L 13.5,4.5 L 10.5,1.5 L 11.5,0.5 Z M 1,2 L 8,2 L 6,4 L 3,4 L 3,13 L 12,13 L 12,10 L 14,8 L 14,14 C 14,14.5 13.5,15 13,15 L 2,15 C 1.5,15 1,14.5 1,14 L 1,3 C 1,2.5 1.5,2 2,2 Z" 
                                          Fill="{StaticResource Black}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>

                                <!-- Delete / X-Mark -->
                                <Button Background="Transparent" Padding="5"
                                        Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" Margin="2">
                                    <Path Data="M 1.5,0 L 6,4.5 L 10.5,0 L 12,1.5 L 7.5,6 L 12,10.5 L 10.5,12 L 6,7.5 L 1.5,12 L 0,10.5 L 4.5,6 L 0,1.5 Z" 
                                          Fill="{StaticResource ErrorRed}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[RunSelected]}" Command="{Binding RunSelectedJobCommand}" Margin="0,0,10,0"/>
            <Button Content="{Binding Source={x:Static helpers:TranslationSource.Instance}, Path=[RunAll]}" Command="{Binding RunAllJobsCommand}" Style="{StaticResource CTAButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>